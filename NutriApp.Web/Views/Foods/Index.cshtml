@model IEnumerable<NutriApp.Web.Models.Food>

@{
    ViewData["Title"] = "Gestión de alimentos"; 
}

<div class="container mt-4">
    <h1>Gestión de alimentos</h1>

    <p>Registra y consulta los alimentos de NutriApp.</p> 

    <hr />

    <h2>Registrar alimento</h2>

    <form asp-controller="Foods" asp-action="Create" method="post">
        <input type="hidden" name="Id" value="0" />

        <div class="mb-3"> 
            <label for="name" class="form-label">Nombre del alimento</label>
            <input type="text"
                   id="name"
                   name="Name"
                   class="form-control"
                   placeholder="Ejemplo: Manzana" />
        </div>

        <div class="mb-3">
            <label for="calories" class="form-label">Calorías por 100 gramos</label>
            <input type="number"
                   id="calories"
                   name="Calories"
                   class="form-control"
                   min="0"
                   step="0.1"
                   placeholder="Ejemplo: 52" />
        </div>

        <div class="mb-3">
            <label for="proteins" class="form-label">Proteínas por 100 gramos (g)</label>
            <input type="number"
                   id="proteins"
                   name="Proteins"
                   class="form-control"
                   min="0"
                   step="0.1"
                   placeholder="Ejemplo: 0.3" />
        </div>

        <button type="submit" class="btn btn-success">
            Registrar alimento
        </button>
    </form>
    
    <hr class="mt-5" />

    @if (!Model.Any())
    {
        <p>Aun no hay alimentos registrados.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Calorias por 100 g</th>
                    <th>Proteinas por 100 g</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var food in Model)
                {
                  <tr>
                      <td>@food.Name</td>
                      <td>@food.Calories</td>
                      <td>@food.Proteins</td>
                  </tr>  
                }
            </tbody>
        </table>
    }
</div>
