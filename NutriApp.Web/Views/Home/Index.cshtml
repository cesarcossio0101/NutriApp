@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">NutriApp</h1>

    <p class="lead">
        Nutrición y organización en una sola app.
    </p>

    <hr />

    <h2>Organiza tu alimentación</h2>

    <p>
        Planifica tus comidas, administra tus recetas
        y organiza tu mercado desde un solo lugar.
    </p>

    <div class="mt-4">
        <a class="btn btn-success btn-lg"
           href="#funcionalidades">
            Comenzar
        </a>
    </div>
</div>

<div id="funcionalidades" class="row mt-5 text-center">
    <div class="col-md-4 mb-3">
        <h3>Alimentos</h3>
        <p>Administra los alimentos y sus valores nutricionales.</p>
    </div>

    <div class="col-md-4 mb-3">
        <h3>Planificación</h3>
        <p>Organiza tus comidas durante la semana.</p>
    </div>

    <div class="col-md-4 mb-3">
        <h3>Lista de mercado</h3>
        <p>Organiza los ingredientes que necesitas comprar.</p>
    </div>
</div>
